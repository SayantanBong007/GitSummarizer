# =============================================================================
# GitSummarize — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Groq (primary + two fallbacks). REQUIRED: the app will not start
# without GROQ_API_KEY — backend/config.py declares it with no default.
# On failure the chain automatically tries: primary → fallback_1 → fallback_2
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_1=openai/gpt-oss-20b
GROQ_FALLBACK_2=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# LLM (OpenRouter) — optional, last-resort fallback only (see backend/llm/client.py)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_1=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_2=qwen/qwen3-coder:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gitsummarize
POSTGRES_USER=gitsummarize
POSTGRES_PASSWORD=gitsummarize_secret
DATABASE_URL=postgresql+asyncpg://gitsummarize:gitsummarize_secret@localhost:5432/gitsummarize

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gitsummarize_secret

# -----------------------------------------------------------------------------
# Qdrant (vector DB)
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=gitsummarize_embeddings

# -----------------------------------------------------------------------------
# Redis (Celery broker + result backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPO_CLONE_BASE_PATH=/tmp/gitsummarize/repos
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Embedding model (local sentence-transformers)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
